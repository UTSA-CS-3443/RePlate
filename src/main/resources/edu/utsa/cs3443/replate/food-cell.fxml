<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.utsa.cs3443.replate.FoodCellController"
      alignment="CENTER_LEFT"
      spacing="10"
      styleClass="food-row">

    <children>
        <!-- Food name and category icon -->
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              minWidth="230"
              prefWidth="230"
              maxWidth="230">

            <ImageView fx:id="categoryIcon"
                       fitWidth="28"
                       fitHeight="28"
                       preserveRatio="true"/>

            <Label fx:id="nameLabel"
                   styleClass="food-name"/>
        </HBox>

        <!-- Quantity -->
        <HBox alignment="CENTER_LEFT"
              minWidth="180"
              prefWidth="180"
              maxWidth="180">

            <Label fx:id="quantityLabel"/>
        </HBox>

        <!-- Best before -->
        <HBox alignment="CENTER_LEFT"
              minWidth="130"
              prefWidth="130"
              maxWidth="130">

            <Label fx:id="expireLabel"
                   styleClass="expiration-badge"/>
        </HBox>

        <!-- Edit and delete icons -->
        <HBox alignment="CENTER_RIGHT"
              spacing="5"
              minWidth="75"
              prefWidth="75"
              maxWidth="75">

            <Button fx:id="editButton"
                    styleClass="more-options"
                    onAction="#onEditClick"/>

            <Button fx:id="deleteButton"
                    styleClass="more-options"
                    onAction="#onDeleteClick"/>
        </HBox>
    </children>
</HBox>